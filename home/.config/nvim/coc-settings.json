{
    "suggest.noselect": true,
    "semanticTokens.enable": true,
    "semanticTokens.filetypes": ["c", "cpp", "rust"],
    "[rust]": {
        "semanticTokens.enable": true,
        "inlayHint.enable": true
    },
    "rust-analyzer.server.path": "~/.cargo/bin/rust-analyzer",
    "rust-analyzer.check.command": "clippy",
    "[zig]": {
        "coc.preferences.formatOnSave": true,
        "semanticTokens.enable": true
    },
    "languageserver": {
      "rescript": {
        "enable": true,
        "module": "~/.local/share/nvim/plugged/vim-rescript/server/out/server.js",
        "args": ["--node-ipc"],
        "filetypes": ["rescript"],
        "rootPatterns": ["bsconfig.json"]
      },
      "nim": {
         "command": "/home/joey/.nimble/bin/nimlangserver",
         "filetypes": ["nim"],
         "trace.server": "verbose",
           "settings": {
             "nim": {
               "nimsuggestPath": "/home/joey/Nim/bin/nimsuggest"
           }
         }
      },
      "ocaml-lsp": {
        "command": "opam",
        "args": ["config", "exec", "--", "ocamllsp"],
        "filetypes": ["ocaml", "reason"]
      },
      "haskell": {
          "command": "haskell-language-server-wrapper",
          "args": ["--lsp"],
          "rootPatterns": ["*.cabal", "stack.yaml", "cabal.project", "package.yaml", "hie.yaml"],
          "filetypes": ["haskell", "lhaskell"]
      },
      "zls": {
        "command": "/usr/local/bin/zls",
        "filetypes": [ "zig", "zon" ],
        "settings": {
          "zls.zig_exe_path": "/usr/local/bin/zig"
        }
      }
    },
    "clangd.path": "~/.config/coc/extensions/coc-clangd-data/install/12.0.1/clangd_12.0.1/bin/clangd",
    "python.venvPath": ".venv"
}
